const med=a=>{a=[...a].sort((x,y)=>x-y);return a[a.length>>1]};
function detectar1(img,inv,lim){
 const k=Math.min(1,1600/img.naturalWidth),w=Math.round(img.naturalWidth*k),h=Math.round(img.naturalHeight*k);
 const c=document.createElement('canvas');c.width=w;c.height=h;const g=c.getContext('2d',{willReadFrequently:true});g.drawImage(img,0,0,w,h);
 const d=g.getImageData(0,0,w,h).data,n=new Uint8Array(w*h);let tinta=0;
 for(let i=0;i<n.length;i++){const L=d[i*4]*.3+d[i*4+1]*.59+d[i*4+2]*.11;if(d[i*4+3]>128&&(inv?L>lim:L<lim)){n[i]=1;tinta++}}
 if(tinta>n.length*.5)return null;
 const seen=new Uint8Array(n.length);let cs=[];
 for(let s0=0;s0<n.length;s0++){if(!n[s0]||seen[s0])continue;const q=[s0];seen[s0]=1;let x0=w,x1=0,y0=h,y1=0,cnt=0;
  while(q.length){const i=q.pop(),x=i%w,y=(i-x)/w;cnt++;if(x<x0)x0=x;if(x>x1)x1=x;if(y<y0)y0=y;if(y>y1)y1=y;
   for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){const xx=x+dx,yy=y+dy;if(xx<0||yy<0||xx>=w||yy>=h)continue;const j=yy*w+xx;if(n[j]&&!seen[j]){seen[j]=1;q.push(j)}}}
  const bh=y1-y0+1,bw=x1-x0+1;if(bh>=8&&bh<=90&&bw<=bh*1.5&&cnt<bw*bh*.9)cs.push({x0,x1,y0,y1})}
 if(cs.length<6)return null;
 const fim=(cs0,fator)=>{let cs=[...cs0];
 const wd=med(cs.map(o=>o.x1-o.x0+1)),P=cs.map((_,i)=>i),f=i=>P[i]===i?i:(P[i]=f(P[i]));
 cs.sort((a,b)=>a.x0-b.x0);
 for(let i=0;i<cs.length;i++)for(let j=i+1;j<cs.length;j++){const a=cs[i],b=cs[j],gap=b.x0-a.x1;if(gap>Math.max(2,fator*wd))break;
  const ov=Math.min(a.y1,b.y1)-Math.max(a.y0,b.y0),mh=Math.min(a.y1-a.y0,b.y1-b.y0);if(ov>=.5*mh)P[f(j)]=f(i)}
 const G={};cs.forEach((o,i)=>{const r=f(i),t=G[r]||(G[r]={x0:1e9,x1:0,y0:1e9,y1:0});t.x0=Math.min(t.x0,o.x0);t.x1=Math.max(t.x1,o.x1);t.y0=Math.min(t.y0,o.y0);t.y1=Math.max(t.y1,o.y1)});
 cs=Object.values(G).map(o=>({x:(o.x0+o.x1+1)/2/k,y:(o.y0+o.y1+1)/2/k,h:(o.y1-o.y0+1)/k}));
 const mh=med(cs.map(o=>o.h));cs.sort((a,b)=>a.y-b.y);const rows=[];
 for(const o of cs){const r=rows[rows.length-1];if(r&&Math.abs(o.y-r.y/r.l.length)<mh*.6){r.l.push(o);r.y+=o.y}else rows.push({l:[o],y:o.y})}
 // só linhas com espaçamento regular (descarta títulos, letras, enfeites)
 const reg=r=>{if(r.l.length<3)return false;const hr=med(r.l.map(o=>o.h));if(hr>1.35*mh||hr<.65*mh)return false;const xs=r.l.map(o=>o.x).sort((a,b)=>a-b),df=xs.slice(1).map((v,i)=>v-xs[i]),m=med(df);return df.filter(v=>v>=.7*m&&v<=1.45*m).length>=df.length*.7};
 const big=rows.filter(reg);if(!big.length)return null;
 const mx=Math.max(...big.map(r=>r.l.length)),ok=big.filter(r=>r.l.length>=Math.max(3,mx*.6));
 const cnt={};ok.forEach(r=>cnt[r.l.length]=(cnt[r.l.length]||0)+1);
 const colunas=+Object.entries(cnt).sort((a,b)=>b[1]-a[1]||b[0]-a[0])[0][0];
 const full=ok.find(r=>r.l.length===colunas),xs=full.l.map(o=>o.x).sort((a,b)=>a-b);
 const ys=ok.map(r=>r.y/r.l.length);if(colunas<2)return null;
 const espX=med(xs.slice(1).map((v,i)=>v-xs[i])),espY=ys.length>1?med(ys.slice(1).map((v,i)=>v-ys[i])):S.cfg.espacoY;
 const al=ok.filter(r=>r.l.length===colunas&&r.l.map(o=>o.x).sort((a,b)=>a-b).every((x,i)=>Math.abs(x-xs[i])<.25*espX)).length;
 if(al<2||ok.length<2)return null;
 return{colunas,linhas:ok.length,quantidade:ok.reduce((t,r)=>t+r.l.length,0),inicioX:Math.round(xs[0]),inicioY:Math.round(ys[0]),
  espacoX:Math.round(espX),espacoY:Math.round(espY),fonte:Math.round(mh/.72),raio:Math.round(espX*.42),share:al/ok.length}};
 let best=null;for(const t of [.4,.55,.7]){const r=fim(cs,t);if(r&&(!best||r.share>best.share+.001))best=r}
 if(!best)return null;const {share,...res}=best;return res}
