<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Rifas</title>
<link rel="manifest" href="manifest.webmanifest">
<meta name="theme-color" content="#e6a623">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Rifas">
<link rel="icon" type="image/png" href="rifa.png">
<link rel="apple-touch-icon" href="icon-192.png">
<style>
:root{--b:#e6a623;--f:#f5efe3;--c:#fff;--t:#2d2d2d;--ok:#2e9e5b;--bad:#d64545}
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',system-ui,-apple-system,Roboto,Arial,sans-serif}
body{background:var(--f);color:var(--t);padding:14px 14px 90px;max-width:1100px;margin:auto}
nav{display:flex;gap:8px;margin-bottom:16px;position:sticky;top:0;background:var(--f);padding:6px 0;z-index:5}
nav button{flex:1}
button{background:var(--b);color:#fff;border:none;padding:11px 14px;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer;transition:.15s}
button:hover{filter:brightness(.92)}button:active{transform:scale(.97)}
button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #0b6;outline-offset:2px}
nav button:not(.on){opacity:.55}
.sec{display:none}.sec.on{display:block}
.card{background:var(--c);padding:18px;border-radius:18px;box-shadow:0 2px 10px #0001;margin-bottom:16px}
.card h2{margin-bottom:12px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
label{font-size:13px;font-weight:700;display:block;margin-bottom:4px}
input,select{width:100%;padding:11px;border-radius:10px;border:2px solid #d8c7a3;font-size:16px;background:#fff;color:#2d2d2d}
input[type=color]{padding:0;height:42px;cursor:pointer}
input[type=checkbox]{width:22px;height:22px;accent-color:var(--b)}
.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.row>*{flex:1;min-width:140px}
.big{width:100%;padding:15px;font-size:17px;margin-top:14px}
.sec-btn{background:#fff;color:var(--t);border:2px solid #d8c7a3}
.bad{background:var(--bad)}.ok{background:var(--ok)}
.cv{background:var(--c);border-radius:18px;padding:8px;box-shadow:0 2px 10px #0001;overflow:auto}
canvas{width:100%;height:auto;display:block;border-radius:14px;cursor:pointer}
.hint{font-size:13px;opacity:.7;margin-top:6px}
.resumo{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:14px}
.resumo .card{text-align:center;margin:0;padding:14px}.resumo b{font-size:22px;display:block;margin-top:4px}
.bar{height:10px;background:#0001;border-radius:9px;overflow:hidden;margin-top:8px}.bar i{display:block;height:100%;background:var(--b);transition:width .4s}
table{width:100%;border-collapse:collapse;background:var(--c);border-radius:16px;overflow:hidden;box-shadow:0 2px 10px #0001}
th{background:var(--b);color:#fff;padding:12px}td{padding:10px;text-align:center;border-bottom:1px solid #0001}
td .mini{padding:6px 9px;font-size:13px;margin:2px}
.tag{padding:3px 10px;border-radius:20px;font-size:12px;font-weight:700;color:#fff}
@media(max-width:700px){thead{display:none}table,tbody,tr,td{display:block;width:100%}
tr{padding:10px;margin-bottom:10px;background:var(--c);border-radius:14px;box-shadow:0 2px 8px #0001}
td{display:flex;justify-content:space-between;text-align:right;border:none;padding:5px 4px;gap:10px}
td::before{content:attr(data-l);font-weight:700;text-align:left}
td.acoes{justify-content:center;flex-wrap:wrap}td.acoes::before{display:none}
table{background:none;box-shadow:none}
nav{position:fixed;top:auto;bottom:0;left:0;right:0;padding:10px;box-shadow:0 -3px 12px #0002;background:var(--c)}}
.ncards{display:grid;grid-template-columns:repeat(auto-fill,minmax(88px,1fr));gap:8px}
.nc{background:var(--c);border-radius:14px;padding:10px 6px;text-align:center;box-shadow:0 2px 8px #0001;min-width:0}
.nc b{font-size:24px;display:block;line-height:1.2}.nc span{font-size:12px;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nc.pend{outline:2px dashed #c98c16;opacity:.75}.nc.g{grid-column:span 2;padding:10px}.nc.g strong{display:block;font-size:15px;margin-bottom:4px}.nc.g div{font-size:14px;line-height:1.4;word-break:break-word}
#sorteioNum:empty,#sorteioRes:empty{display:none}
input[type=color]{width:54px;height:54px;padding:2px;border-radius:14px;cursor:pointer;display:block}
#config .grid{grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px}
#config #cores,#config #cq{grid-template-columns:repeat(auto-fill,minmax(70px,1fr))}
#cores div,#cq div{text-align:center}#cores label,#cq label{font-size:12px}#cores input,#cq input{margin:0 auto}
#config .box{padding:12px;margin-bottom:10px}#config .box h3{margin-bottom:8px;font-size:16px}
#config .card{padding:14px}
#sorteioNum{font-size:110px;font-weight:800;text-align:center;color:var(--b);min-height:130px}
#sorteioRes{text-align:center;font-size:28px;font-weight:700;margin:10px 0 20px}
.pop{position:fixed;inset:0;background:#000a;display:none;align-items:center;justify-content:center;z-index:99}
.pop.on{display:flex}.pop>div{background:var(--f);width:92%;max-width:400px;border-radius:24px;padding:26px;text-align:center;position:relative;max-height:92vh;overflow:auto}
.pop img{width:220px;max-width:100%;border-radius:16px;margin:12px 0}.pop p{margin:8px 0;font-weight:700;word-break:break-word}
.x{position:absolute;top:10px;right:10px;background:none;color:var(--t);font-size:22px;padding:6px 10px}
#toast{position:fixed;left:50%;bottom:84px;transform:translateX(-50%);background:#222;color:#fff;padding:12px 18px;border-radius:14px;display:none;z-index:200;align-items:center;gap:12px;max-width:92%}
#toast.on{display:flex}#toast button{background:var(--b);padding:6px 12px}
.pg{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0}.pg span{background:#0001;padding:5px 10px;border-radius:20px;cursor:pointer}
.box{border:2px solid #d8c7a3;border-radius:16px;padding:14px;margin-bottom:14px}
</style>
</head>
<body>
<select id="rifaSel" aria-label="Rifa atual" style="margin-bottom:10px;font-weight:700;font-size:17px"></select>
<nav role="tablist" id="tabs">
 <button data-t="rifa" class="on">🎟️ RIFA</button><button data-t="vendas">💰 VENDAS</button>
 <button data-t="sorteio">🎉 SORTEIO</button><button data-t="config">⚙️</button>
</nav>

<section id="rifa" class="sec on">
 <div class="card"><h2>Registrar Compra</h2>
  <div class="grid">
   <div><label for="nome">Nome</label><input id="nome" autocomplete="off"></div>
   <div><label for="contato">WhatsApp</label><input id="contato" placeholder="(84) 91234-5678" inputmode="numeric" maxlength="15"><label style="display:flex;gap:8px;align-items:center;font-weight:400;margin:8px 0 0"><input type="checkbox" id="semZap" style="width:18px;height:18px"> Cliente sem WhatsApp</label></div>
   <div><label for="numeros">Número(s)</label><input id="numeros" placeholder="Toque na cartela ou digite: 5, 12, 25" inputmode="numeric"></div>
   <div><label for="pagamento">Pagamento</label><select id="pagamento"></select></div>
   <div><label for="pago">Situação</label><select id="pago"><option value="pagar">💠 Pagar (abre o Pix)</option><option value="1">✅ Pago</option><option value="0">⏳ Pendente</option></select></div>
  </div>
  <button class="big" id="btConcluir">CONCLUIR</button>
  <button class="big sec-btn" id="btCancelar" style="display:none">Cancelar edição</button>
 </div>
 <div class="cv"><canvas id="cv"></canvas></div>
 <p class="hint">💡 Toque nos números da cartela para selecioná-los. Toque num vendido para ver o comprador.</p>
 <div class="row"><button id="btShare" class="ok">📤 COMPARTILHAR</button><button id="btBaixar">⬇️ BAIXAR IMAGEM</button><button id="btPix">PAGAR COM PIX</button></div>
</section>

<section id="vendas" class="sec">
 <div class="resumo" id="resumo"></div>
 <div class="row"><input id="busca" placeholder="🔍 Buscar nome, número ou contato"><select id="filtro" style="max-width:150px"><option value="">Todas</option><option value="0">⏳ Pendentes</option><option value="1">✅ Pagas</option></select><button id="btCsv" class="sec-btn">📄 Exportar CSV</button><button id="btLimpar" class="bad">🗑️ Limpar vendas</button></div>
 <br>
 <table><thead><tr><th>Data</th><th>Comprador</th><th>Números</th><th>Contato</th><th>Pagamento</th><th>Total</th><th>Situação</th><th>Ações</th></tr></thead><tbody id="hist"></tbody></table>
</section>

<section id="sorteio" class="sec">
 <div class="card">
  <div class="row" style="align-items:center"><label style="display:flex;gap:8px;align-items:center"><input type="checkbox" id="soPagos" checked> Sortear só entre números pagos</label></div>
  <button class="big" id="btSortear">🎲 SORTEAR</button>
  <div id="sorteioNum"></div><div id="sorteioRes" aria-live="polite"></div>
  <h3>Último sorteio</h3><p id="ultimo" class="hint">—</p>
 </div>
 <div class="row" style="margin:0 0 12px"><button id="ordNum">🔢 Por número</button><button id="ordNome" class="sec-btn">🔤 Por nome</button></div>
 <div id="listaSort" class="ncards"></div>
</section>

<section id="config" class="sec">
 <div class="card"><h2>Configurações</h2>
  <div class="box"><h3>Esta rifa</h3><label for="rifaNome">Nome da rifa</label><input id="rifaNome" maxlength="40"><div class="row"><button id="rifaNova">➕ Nova rifa</button><button id="rifaDel" class="bad">🗑️ Excluir esta rifa</button></div><p class="hint">Cada rifa tem vendas, imagem, Pix, pagamentos, cores e ajustes próprios. A nova rifa começa copiando as configurações da atual.</p></div>
  <div class="box"><h3>Imagem da Rifa</h3><input type="file" id="fImg" accept="image/*"><div class="hint" id="stImg"></div><button class="sec-btn" id="rmImg" style="margin-top:8px">Remover imagem</button></div>
  <div class="box"><h3>Pix</h3>
   <div class="grid"><div><label>Chave</label><input id="pxChave"></div><div><label>Nome</label><input id="pxNome"></div><div><label>Banco</label><input id="pxBanco"></div><div><label>Cidade</label><input id="pxCidade" maxlength="15"></div><div><label>Nome curto (aparece no Pix)</label><input id="pxCurto" maxlength="25"></div></div></div>
  <div class="box"><h3>Formas de pagamento</h3><div class="pg" id="listaPg"></div>
   <div class="row"><input id="novoPg" placeholder="Ex: R$25 ou Fralda RN"><button id="addPg">Adicionar</button></div>
   <p class="hint">Toque numa forma para remover. Valores com "R$" são somados em dinheiro.</p></div>
  <div class="box"><h3>Cores</h3><div class="grid" id="cores"></div></div>
  <div class="box" id="boxQ"><h3>Cores dos quadrados</h3><div class="grid" id="cq"></div></div>
  <div class="box"><h3>Ajuste da cartela</h3><label style="display:flex;gap:8px;align-items:center;font-weight:700;margin-bottom:10px;font-size:14px"><input type="checkbox" id="cobrirOn"> Redesenhar todos os números sobre a imagem (mais nítido)</label>
<label style="display:flex;gap:8px;align-items:center;font-weight:700;margin-bottom:10px;font-size:14px"><input type="checkbox" id="rodapeOn"> Incluir legenda e data na imagem compartilhada</label>
<label style="display:flex;gap:8px;align-items:center;font-weight:700;margin-bottom:10px;font-size:14px"><input type="checkbox" id="estiloQ"> Usar quadrados coloridos (desmarcado = emojis)</label>
<label style="display:flex;gap:8px;align-items:center;font-weight:700;margin-bottom:10px;font-size:14px"><input type="checkbox" id="ocultaNum"> Ocultar números do sistema (a imagem já tem os números)</label>
<div class="row"><button id="btDetect">🔍 Detectar grade automaticamente</button><button id="btCalib" class="sec-btn">📍 Calibrar tocando (3 toques)</button></div><br><div class="grid" id="ajustes"></div></div>
  <div class="box"><h3>Backup</h3><p class="hint" id="stBackup" style="margin:0 0 8px"></p><div class="row"><button id="btExpTudo" class="ok">⬇️ Exportar TODAS as rifas</button><button id="btExp" class="sec-btn">⬇️ Só esta rifa</button><button id="btImp" class="sec-btn">⬆️ Importar backup</button></div></div>
  <input type="file" id="fImp" accept=".json" hidden>
 </div>
</section>

<div class="pop" id="pop" role="dialog" aria-modal="true"><div><button class="x" id="fechaPop" aria-label="Fechar">✕</button><h2>Pagamento via Pix</h2><div id="popC"></div></div></div>
<div class="pop" id="popZ" role="dialog" aria-modal="true"><div><button class="x" id="fechaZ" aria-label="Fechar">✕</button><h2>Enviar confirmação?</h2><p class="hint" id="zFor"></p><div id="zMsg" style="white-space:pre-wrap;text-align:left;background:#fff;border-radius:14px;padding:12px;margin:10px 0;font-size:14px"></div><button class="big ok" id="zSend">💬 Enviar no WhatsApp</button><button class="big sec-btn" id="zNo">Agora não</button></div></div>
<div class="pop" id="popK" role="dialog" aria-modal="true"><div><button class="x" id="fechaK" aria-label="Fechar">✕</button><h2>Calibrar grade</h2><div class="grid" style="text-align:left"><div><label for="kQ">Quantidade de números</label><input id="kQ" type="number" inputmode="numeric"></div><div><label for="kC">Números por linha</label><input id="kC" type="number" inputmode="numeric"></div></div><label style="display:flex;gap:8px;align-items:center;margin-top:12px;font-weight:700;text-align:left"><input type="checkbox" id="kSem"> A imagem não tem números (o sistema desenha)</label><p class="hint" style="margin-top:10px">Depois toque no centro de 3 lugares da cartela: o nº 1, o último da 1ª linha e o último número.</p><button class="big" id="kGo">Começar</button></div></div>
<div id="toast" role="status"><span id="toastT"></span><button id="toastB" style="display:none"></button></div>

