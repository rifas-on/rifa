  pagamentos:S.pagamentos,configCartela:S.cfg,historicoCores:[],tema:S.tema,pix:S.pix,imagemRifa:S.imgSrc},null,2),'application/json')}
const marcaBackup=()=>{ls.set('ultimoBackup',Date.now());statusBackup()};
function statusBackup(){const t=ls.get('ultimoBackup',0);$('stBackup').textContent=t?'Último backup completo: '+new Date(t).toLocaleString('pt-BR',{dateStyle:'short',timeStyle:'short'}):'⚠️ Nenhum backup completo feito ainda.'}
async function exportarTudo(){const rifas=[];
 for(const r of R.lista)rifas.push({id:r.id,nome:r.nome,dados:ls.get('rifa_'+r.id,{}),img:await idbGet('img_'+r.id)||null,});
 baixar('backup-todas-as-rifas-'+new Date().toISOString().slice(0,10)+'.json',JSON.stringify({tipo:'todas',versao:2,data:new Date().toISOString(),atual:R.atual,rifas}),'application/json');marcaBackup();toast('✅ Backup de todas as rifas baixado!')}
async function importarTudo(d){if(!confirm('Importar vai substituir TODAS as rifas atuais pelas '+d.rifas.length+' do arquivo. Continuar?'))return;
 for(const r of R.lista){ls.del('rifa_'+r.id);await idbSet('img_'+r.id,null)}
 R={lista:d.rifas.map(x=>({id:String(x.id),nome:x.nome||'Rifa'})),atual:d.atual};
 for(const x of d.rifas){ls.set('rifa_'+x.id,x.dados||{});if(x.img)await idbSet('img_'+x.id,x.img)}
 if(!R.lista.some(r=>r.id===R.atual))R.atual=R.lista[0].id;ls.set('rifas',R);await abrirRifa(R.atual);toast('✅ '+R.lista.length+' rifa(s) importada(s)!')}
function lembreteBackup(){const t=ls.get('ultimoBackup',0),dias=(Date.now()-t)/864e5;
 if(!R.lista.some(r=>(ls.get('rifa_'+r.id,{}).vendas||[]).length))return;
 if(!t||dias>7)toast(t?'⚠️ Faz '+Math.floor(dias)+' dias sem backup':'⚠️ Você ainda não fez backup das rifas','Fazer backup',exportarTudo)}
$('btExpTudo').onclick=exportarTudo;
$('btExp').onclick=()=>{exportar();toast('Backup exportado!')};
$('btImp').onclick=()=>$('fImp').click();
$('fImp').onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();
 r.onload=async()=>{try{const d=JSON.parse(r.result);if(d.tipo==='todas'){if(!Array.isArray(d.rifas)||!d.rifas.length||d.rifas.some(x=>!x.id))throw 0;await importarTudo(d);return}if(!Array.isArray(d.vendas||[]))throw 0;if(!confirm('Importar vai substituir os dados atuais. Continuar?'))return;
  S.vendas=(d.vendas||[]).map(normVenda);S.vendas.forEach(v=>v.quantidade=v.numeros.length);
  if(d.pagamentos)S.pagamentos=d.pagamentos;if(d.configCartela)S.cfg={...DEF_CFG,...d.configCartela};if(d.tema)S.tema={...DEF_TEMA,...d.tema};if(d.pix)S.pix={...S.pix,...d.pix};
  if(d.imagemRifa){S.imgSrc=d.imagemRifa;S.img=await carregaImg(S.imgSrc);await idbSet('img_'+S.id,S.imgSrc)}
  save();aplicaTema();montaConfig();syncAj();renderTudo();toast('✅ Backup importado!')}
  catch{toast('Arquivo de backup inválido')}};r.readAsText(f);e.target.value=''};
async function gerarHD(){const big=document.createElement('canvas');const rod=S.cfg.rodape!==false;desenhar(false,big,1,rod);
 const esc=Math.max(1,Math.min(Math.ceil(2400/big.width),6000/Math.max(big.width,big.height)));desenhar(false,big,esc,rod);
 const b=await new Promise(r=>big.toBlob(r,'image/png'));big.width=big.height=0;return new File([b],nomeRifa().replace(/\W+/g,'-')+'.png',{type:'image/png'})}
$('btShare').onclick=async()=>{toast('Gerando imagem em alta definição...');const f=await gerarHD();
 try{if(navigator.canShare&&navigator.canShare({files:[f]})){await navigator.share({files:[f],title:nomeRifa()});$('toast').classList.remove('on');return}}catch(e){if(e.name==='AbortError')return}
 baixarArq(f);toast('Compartilhamento indisponível aqui: a imagem foi baixada.')};
$('btBaixar').onclick=async()=>baixarArq(await gerarHD());
function baixarArq(f){const a=document.createElement('a');a.href=URL.createObjectURL(f);a.download=f.name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),3000)}

/* ---------- Várias rifas ---------- */
function renderRifaSel(){const sel=$('rifaSel');sel.innerHTML='';R.lista.forEach(r=>sel.add(new Option('🎟️ '+r.nome,r.id)));sel.value=S.id;$('rifaNome').value=nomeRifa()}
async function abrirRifa(id){S=lerRifa(id);R.atual=id;ls.set('rifas',R);
 S.imgSrc=await idbGet('img_'+id)||null;S.img=await carregaImg(S.imgSrc);
 aplicaTema();montaConfig();syncAj();renderRifaSel();limparForm();renderTudo()}
$('rifaSel').onchange=e=>abrirRifa(e.target.value);
$('rifaNome').oninput=e=>{R.lista.find(r=>r.id===S.id).nome=e.target.value||'Sem nome';ls.set('rifas',R);const o=$('rifaSel').selectedOptions[0];if(o)o.textContent='🎟️ '+nomeRifa();desenhar()};
$('rifaNova').onclick=async()=>{const id='r'+Date.now().toString(36);
 ls.set('rifa_'+id,{cfg:S.cfg,tema:S.tema,vendas:[],pagamentos:S.pagamentos,pix:S.pix,ultimo:null});
 R.lista.push({id,nome:'Rifa '+(R.lista.length+1)});await abrirRifa(id);aba('config');$('rifaNome').select();toast('✅ Nova rifa criada! Dê um nome e envie a imagem.')};
$('rifaDel').onclick=async()=>{if(R.lista.length<2)return toast('Precisa existir ao menos uma rifa');
 if(!confirm('Excluir "'+nomeRifa()+'" com todas as vendas? Um backup será baixado antes.'))return;
 exportar();const id=S.id;R.lista=R.lista.filter(r=>r.id!==id);ls.del('rifa_'+id);await idbSet('img_'+id,null);
 await abrirRifa(R.lista[0].id);toast('Rifa excluída (backup baixado)')};

/* ---------- Abas e início ---------- */
function aba(id){document.querySelectorAll('.sec').forEach(s=>s.classList.toggle('on',s.id===id));
 document.querySelectorAll('#tabs button').forEach(b=>{b.classList.toggle('on',b.dataset.t===id);b.setAttribute('aria-selected',b.dataset.t===id)});scrollTo(0,0)}
$('tabs').onclick=e=>{if(e.target.dataset.t)aba(e.target.dataset.t)};
function renderTudo(){desenhar();renderVendas();renderSorteio()}
(async function init(){
 if(!R){R={lista:[{id:'r1',nome:'Rifa 1'}],atual:'r1'};ls.set('rifas',R)}
 if(!R.lista.some(r=>r.id===R.atual))R.atual=R.lista[0].id;
 await abrirRifa(R.atual);statusBackup();lembreteBackup();
 if('serviceWorker' in navigator&&location.protocol.startsWith('http'))navigator.serviceWorker.register('sw.js').catch(()=>{});
})();
</script>
</body>
